#!/bin/sh
# Focus the Nth entry of the WezTerm agent bar from anywhere, and bring WezTerm forward on its
# AeroSpace workspace. Bound to ctrl-alt-N in aerospace.toml. The bar order is written by
# wezterm/agents.lua. Full paths: AeroSpace runs this without the shell's PATH.
#
#   agent-jump <n>

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/agent-status"
pane=$(sed -n "${1}p" "$state_dir/bar" 2>/dev/null)
[ -n "$pane" ] || exit 0

/opt/homebrew/bin/wezterm cli activate-pane --pane-id "$pane"
window=$(/opt/homebrew/bin/aerospace list-windows --monitor all --app-bundle-id com.github.wez.wezterm \
	--format '%{window-id}' | head -1)
[ -n "$window" ] && /opt/homebrew/bin/aerospace focus --window-id "$window"
