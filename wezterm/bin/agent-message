#!/bin/sh
# Mark the recipient of a Claude Code cross-session message (the SendMessage tool) so its entry in
# the WezTerm agent bar turns red ("message") until it has finished replying: a <pane>.message
# marker next to its state file, removed by agent-status when the recipient's turn ends (Stop). A
# busy agent picks the message up at its next tool step, an idle one starts on it right away.
# Run from a PreToolUse hook with matcher SendMessage; the hook JSON on stdin names the recipient
# ("to"): a session name, possibly with " [ref]", or "uds:/tmp/cc-socks/<pid>.sock".

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/agent-status"
to=$(jq -r '.tool_input.to // empty' 2>/dev/null)
[ -n "$to" ] || exit 0

# The recipient's process: from its socket path, or by name from Claude Code's session registry.
case $to in
uds:*) pid=$(basename "${to#uds:}" .sock) ;;
*)
	name=${to% \[*\]}
	pid=$(jq -r --arg n "$name" 'select(.name == $n) | .pid' "$HOME"/.claude/sessions/*.json 2>/dev/null | head -1)
	;;
esac
case $pid in '' | *[!0-9]*) exit 0 ;; esac

# Its WezTerm pane, through the terminal it runs on.
tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
[ -n "$tty" ] || exit 0
pane=$(wezterm cli list --format json 2>/dev/null |
	jq -r --arg t "/dev/$tty" '.[] | select(.tty_name == $t) | .pane_id' | head -1)
[ -n "$pane" ] || exit 0

# A recipient without a state file yet (its hooks haven't run) gets one, so the bar lists it.
file="$state_dir/$pane"
mkdir -p "$state_dir"
if [ ! -f "$file" ]; then
	cwd=$(jq -r '.cwd // empty' "$HOME/.claude/sessions/$pid.json" 2>/dev/null)
	printf 'claude\tidle\t%s\t\t\t\n' "$cwd" >"$file.$$" && mv "$file.$$" "$file"
fi
: >"$file.message"

# Redraw the agent bar (see agent-status).
wezterm cli set-window-title "agents $$" >/dev/null 2>&1
