#!/bin/sh
# Report an agent's state to the WezTerm pane it runs in, via OSC 1337 user vars.
# wezterm.lua reads agent / agent_state / agent_title to draw the agent bar.
#
#   agent-status <state> [--agent NAME] [--title TEXT]
#   state: working | waiting | idle | done | clear
#
# Hook JSON on stdin is ignored, so it can be wired straight into Claude Code hooks.

[ -n "$WEZTERM_PANE" ] || exit 0

state=$1
shift
agent=claude
title=
while [ $# -gt 0 ]; do
	case $1 in
	--agent) agent=$2; shift 2 ;;
	--title) title=$2; shift 2 ;;
	*) shift ;;
	esac
done

# Drain stdin so the caller never blocks on a full pipe.
[ -t 0 ] || cat >/dev/null

setvar() {
	printf '\033]1337;SetUserVar=%s=%s\007' "$1" "$(printf %s "$2" | base64 | tr -d '\n')"
}

payload() {
	if [ "$state" = clear ]; then
		setvar agent ""
		setvar agent_state ""
		setvar agent_title ""
	else
		setvar agent "$agent"
		setvar agent_state "$state"
		if [ -n "$title" ]; then setvar agent_title "$title"; fi
	fi
}

# Mirror the state to a file per pane, so tools outside WezTerm (Neovim's agent picker) can
# find agent panes; user vars are only visible to WezTerm itself.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/agent-status"
if [ "$state" = clear ]; then
	rm -f "$state_dir/$WEZTERM_PANE"
else
	mkdir -p "$state_dir"
	printf '%s\t%s\t%s\n' "$agent" "$state" "$PWD" >"$state_dir/$WEZTERM_PANE"
fi

# Hooks usually inherit the pane's controlling tty. If not, look the pane's tty up
# once via the wezterm CLI and cache it.
if (: >/dev/tty) 2>/dev/null; then
	payload >/dev/tty
	exit 0
fi

cache="${TMPDIR:-/tmp}/agent-status-pane-$WEZTERM_PANE"
tty=$(cat "$cache" 2>/dev/null)
if [ -z "$tty" ] || [ ! -w "$tty" ]; then
	tty=$(wezterm cli list --format json 2>/dev/null |
		jq -r --argjson id "$WEZTERM_PANE" '.[] | select(.pane_id == $id) | .tty_name')
	[ -n "$tty" ] && [ -w "$tty" ] || exit 0
	printf %s "$tty" >"$cache"
fi
payload >"$tty"
