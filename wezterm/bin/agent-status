#!/bin/sh
# Report an agent's state for the WezTerm pane it runs in. The state goes to a file per pane, read
# by wezterm/agents.lua (agent bar, focus following) and Neovim (review comment picker).
#
#   agent-status <state> [--agent NAME] [--title TEXT]
#   state: working | waiting | idle | done | clear
#
# Hook JSON on stdin may carry the agent's cwd (Claude Code sends it, and it changes when the
# agent moves into a worktree); without it the hook's own cwd is used.
#
# Nothing is written to the pane's terminal: an escape sequence written there can land in the
# middle of the agent's own output and come out garbled.

[ -n "$WEZTERM_PANE" ] || exit 0

state=$1
shift
agent=claude
title=
while [ $# -gt 0 ]; do
	case $1 in
	--agent) agent=$2; shift 2 ;;
	--title) title=$2; shift 2 ;;
	*) shift ;;
	esac
done

cwd=
if [ ! -t 0 ]; then
	cwd=$(jq -r '.cwd // empty' 2>/dev/null)
fi
[ -d "$cwd" ] || cwd=$PWD

# The worktree the agent works in and its branch (short commit when detached).
root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || root=$cwd
branch=$(git -C "$cwd" branch --show-current 2>/dev/null)
[ -n "$branch" ] || branch=$(git -C "$cwd" rev-parse --short HEAD 2>/dev/null)
# Name of the linked worktree (its folder), empty in the main checkout.
worktree=
if [ "$(git -C "$cwd" rev-parse --path-format=absolute --git-dir 2>/dev/null)" != \
	"$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ]; then
	worktree=$(basename "$root")
fi

# agent <tab> state <tab> root <tab> branch <tab> worktree <tab> title, written whole so readers
# never see half a file.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/agent-status"
file="$state_dir/$WEZTERM_PANE"
if [ "$state" = clear ]; then
	rm -f "$file"
else
	mkdir -p "$state_dir"
	printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$agent" "$state" "$root" "$branch" "$worktree" "$title" >"$file.$$"
	mv "$file.$$" "$file"
fi

# Changing the window title makes WezTerm run format-window-title, which redraws the agent bar.
# The title itself is never shown (agents.lua returns the pane title).
wezterm cli set-window-title "agents $$" >/dev/null 2>&1
